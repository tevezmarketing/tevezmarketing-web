        <form class="lead-form" id="leadForm">
          <div class="lead-options" role="radiogroup" aria-label="Qué necesita">
            <label class="option-chip">
              <input type="radio" name="intent" value="asesoria" checked />
              <span>Asesoría</span>
            </label>
            <label class="option-chip">
              <input type="radio" name="intent" value="servicio" />
              <span>Compra de servicio</span>
            </label>
          </div>
          <div class="lead-grid">
            <label>
              <span>¿De dónde eres?</span>
