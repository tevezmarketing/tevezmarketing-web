                    <small>Growth</small>
                    <h2>Ruptura de mercado</h2>
                  </div>
                  <span class="chip chip-accent">LIVE</span>
                </div>
                <div class="chart-grid">
                  <article class="mini-stat">
                    <span>Reach</span>
                    <strong>+53%</strong>
                    <em>alcance</em>
                  </article>
                  <article class="mini-stat">
                    <span>CTR</span>
                    <strong>+34%</strong>
                    <em>interés</em>
                  </article>
                  <article class="mini-stat">
                    <span>Ventas</span>
                    <strong>+47%</strong>
                    <em>resultado</em>
                  </article>
                </div>
              </div>
            </div>
          </div>
