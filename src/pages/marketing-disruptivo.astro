    <div class="lead-modal" id="lead-qualifier" aria-hidden="true">
      <div class="lead-modal-backdrop" data-close-modal="true"></div>
      <div class="lead-modal-panel" role="dialog" aria-modal="true" aria-labelledby="leadModalTitle">
        <button class="lead-close" type="button" aria-label="Cerrar formulario">×</button>
        <div class="lead-qualifier-copy lead-modal-copy">
          <p class="eyebrow">Diagnóstico rápido</p>
          <h2 id="leadModalTitle">Te ayudamos a encontrar tu diferencia real.</h2>
          <p class="lead-note">Una estrategia clara para salir del ruido y construir una marca más valiosa.</p>
        </div>
        <form class="lead-form" id="leadForm">
          <div class="lead-options" role="radiogroup" aria-label="Qué necesita">
            <label class="option-chip">
              <input type="radio" name="intent" value="asesoria" checked />
              <span>Asesoría</span>
            </label>
            <label class="option-chip">
              <input type="radio" name="intent" value="servicio" />
              <span>Compra de servicio</span>
            </label>
          </div>
          <div class="lead-grid">
            <label>
              <span>¿De dónde eres?</span>
              <select name="city" required>
                <option value="">Selecciona tu ciudad</option>
                <option>Ibagué</option>
                <option>Tolima</option>
                <option>Bogotá</option>
                <option>Medellín</option>
                <option>Otro</option>
              </select>
            </label>
            <label>
              <span>Tu nombre</span>
              <input type="text" name="name" placeholder="Ej. Camila" required />
            </label>
          </div>
          <button class="primary-button" type="submit">Continuar a WhatsApp</button>
        </form>
