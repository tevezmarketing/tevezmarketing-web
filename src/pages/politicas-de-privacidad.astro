---
import GoogleTagManager from '../components/GoogleTagManager.astro';
---

<!DOCTYPE html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Políticas de privacidad | Tevez Marketing</title>
    <meta name="description" content="Políticas de privacidad de Tevez Marketing: tratamiento de datos, consentimiento, información y protección de usuarios." />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href="https://tevezmarketing.digital/politicas-de-privacidad/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body data-theme="charcoal">
    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand" href="https://tevezmarketing.digital" aria-label="Tevez Marketing inicio">
          <span class="brand-mark">T</span>
          <span class="brand-text">
            <strong>Tevez</strong>
            <small>Marketing</small>
          </span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menú">
          <span></span><span></span><span></span>
        </button>

        <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
          <a href="https://tevezmarketing.digital">Inicio</a>
          <div class="nav-item nav-item--submenu">
            <button class="nav-drop-toggle" type="button" aria-expanded="false" aria-controls="services-menu">
              Nuestros servicios
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3.5 6l4.5 4.5L12.5 6" />
              </svg>
            </button>
            <div class="nav-submenu" id="services-menu">
              <a href="https://tevezmarketing.digital/estrategias-de-ventas/">Estrategias de ventas</a>
              <a href="https://tevezmarketing.digital/optimizacion-de-campanas/">Optimización de campañas</a>
              <a href="https://tevezmarketing.digital/anuncios-sectores-regulados/">Anuncios sectores regulados</a>
              <a href="https://tevezmarketing.digital/sitios-web-ibague/">Sitios web Ibagué</a>
              <a href="https://tevezmarketing.digital/google-ads-ibague/">Google Ads Ibagué</a>
              <a href="https://tevezmarketing.digital/publicidad-en-redes/">Publicidad en redes</a>
            </div>
          </div>
          <a href="https://tevezmarketing.digital/quienes-somos/">Quiénes somos</a>
          <a href="https://tevezmarketing.digital/casos-de-exito/">Casos de éxito</a>
          <a href="https://tevezmarketing.digital/protocolo-360/">Protocolo 360</a>
          <div class="nav-item nav-item--submenu">
            <button class="nav-drop-toggle" type="button" aria-expanded="false" aria-controls="coverage-menu">
              Cobertura
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3.5 6l4.5 4.5L12.5 6" />
              </svg>
            </button>
            <div class="nav-submenu" id="coverage-menu">
              <a href="https://tevezmarketing.digital/marketing-bogota/">Marketing Bogotá</a>
              <a href="https://tevezmarketing.digital/marketing-medellin/">Marketing Medellín</a>
              <a href="https://tevezmarketing.digital/marketing-cali/">Marketing Cali</a>
              <a href="https://tevezmarketing.digital/marketing-usa/">Marketing USA</a>
            </div>
          </div>
          <a href="https://tevezmarketing.digital/noticias/">Noticias</a>
          <button class="nav-cta lead-trigger" type="button">Consulta gratis</button>
        </nav>
      </div>
    </header>

    <main class="landing-page">
      <section class="landing-hero theme-charcoal" data-theme="charcoal">
        <div class="container hero-grid">
          <div class="hero-copy reveal">
            <p class="eyebrow">Políticas de privacidad</p>
            <h1>Tu información está protegida con criterio y transparencia.</h1>
            <p class="lead">
              En Tevez Marketing tratamos los datos con responsabilidad, con fines claros y con una política de uso que busca respetar la confianza de cada persona.
            </p>
            <div class="cta-row">
              <button class="primary-button lead-trigger" type="button">Hablar con Tevez</button>
              <a class="secondary-button" href="#contenido">Ver políticas</a>
            </div>
            <ul class="hero-trust" aria-label="Principios clave">
              <li><strong>Transparencia</strong><span>información clara y honesta</span></li>
              <li><strong>Consentimiento</strong><span>datos solo con propósito definido</span></li>
              <li><strong>Seguridad</strong><span>medidas para proteger la información</span></li>
            </ul>
          </div>

          <div class="hero-visual reveal">
            <div class="dashboard-window">
              <div class="window-topbar">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <div class="dashboard-body">
                <div class="panel-head">
                  <div>
                    <small>Legal</small>
                    <h2>Protección de datos</h2>
                  </div>
                  <span class="chip chip-accent">SECURE</span>
                </div>
                <div class="chart-grid">
                  <article class="mini-stat">
                    <span>Datos</span>
                    <strong>Uso</strong>
                    <em>limitado</em>
                  </article>
                  <article class="mini-stat">
                    <span>Confianza</span>
                    <strong>Alta</strong>
                    <em>transparencia</em>
                  </article>
                  <article class="mini-stat">
                    <span>Control</span>
                    <strong>Voluntad</strong>
                    <em>del usuario</em>
                  </article>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section theme-marfil" id="contenido" data-theme="marfil">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Información</p>
            <h2>Principios de tratamiento de datos y uso de la información.</h2>
          </div>
          <div class="landing-grid">
            <article class="reveal">
              <h3>1. Información que recopilamos</h3>
              <p>Podemos recibir información personal que la persona nos proporcione directamente, como nombre, ciudad, correo, teléfono, negocio o intereses.</p>
            </article>
            <article class="reveal">
              <h3>2. Finalidad del tratamiento</h3>
              <p>Usamos la información para responder consultas, gestionar oportunidades, atender solicitudes, ofrecer asesorías y mantener contacto comercial.</p>
            </article>
            <article class="reveal">
              <h3>3. Seguridad</h3>
              <p>Aplicamos medidas razonables para proteger la información frente a acceso no autorizado, pérdida o uso indebido.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section theme-white" data-theme="white">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Uso responsable</p>
            <h2>Los datos se tratan de forma responsable y con fines definidos.</h2>
          </div>
          <div class="landing-steps">
            <article class="reveal"><span>01</span><h3>Consentimiento</h3><p>Solicitamos permiso cuando se requiere para contacto, seguimiento o atención comercial.</p></article>
            <article class="reveal"><span>02</span><h3>Limitación</h3><p>Usamos la información solo para las finalidades que fueron comunicadas y aceptadas.</p></article>
            <article class="reveal"><span>03</span><h3>Acceso</h3><p>La persona puede solicitar información sobre sus datos o pedir su actualización o eliminación.</p></article>
            <article class="reveal"><span>04</span><h3>Actualización</h3><p>Podemos revisar esta política para reflejar cambios en la operación o en la normativa aplicable.</p></article>
          </div>
        </div>
      </section>

      <section class="section pricing-section theme-champagne" data-theme="champagne">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Contacto</p>
            <h2>Si quieres consultar el tratamiento de tus datos, puedes escribirnos directamente.</h2>
          </div>
          <div class="landing-results">
            <article class="reveal">
              <h3>Correo</h3>
              <p>Tevez Marketing atiende consultas sobre privacidad y tratamiento de datos con respuesta clara y respetuosa.</p>
            </article>
            <article class="reveal">
              <h3>WhatsApp</h3>
              <p>También puedes contactarnos por WhatsApp para hablar sobre tus dudas y para gestionar una consulta.</p>
            </article>
            <article class="reveal">
              <h3>Responsabilidad</h3>
              <p>La operación del sitio y la atención comercial buscan respetar la ley y la confianza del usuario.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section theme-charcoal" data-theme="charcoal">
        <div class="container landing-cta-box reveal">
          <h2>La confianza se construye con claridad, respeto y buenas prácticas.</h2>
          <button class="primary-button lead-trigger" type="button">Consultar privacidad</button>
        </div>
      </section>
    </main>

    <div class="lead-modal" id="lead-qualifier" aria-hidden="true">
      <div class="lead-modal-backdrop" data-close-modal="true"></div>
      <div class="lead-modal-panel" role="dialog" aria-modal="true" aria-labelledby="leadModalTitle">
        <button class="lead-close" type="button" aria-label="Cerrar formulario">×</button>
        <div class="lead-qualifier-copy lead-modal-copy">
          <p class="eyebrow">Consulta</p>
          <h2 id="leadModalTitle">Necesitas aclarar algo sobre privacidad o contacto.</h2>
          <p class="lead-note">Podemos ayudarte a resolver dudas sobre la información que compartes y cómo la tratamos.</p>
        </div>
        <form class="lead-form" id="leadForm">
          <div class="lead-options" role="radiogroup" aria-label="Qué necesita">
            <label class="option-chip">
              <input type="radio" name="intent" value="asesoria" checked />
              <span>Asesoría</span>
            </label>
            <label class="option-chip">
              <input type="radio" name="intent" value="servicio" />
              <span>Compra de servicio</span>
            </label>
          </div>
          <div class="lead-grid">
            <label>
              <span>¿De dónde eres?</span>
              <select name="city" required>
                <option value="">Selecciona tu ciudad</option>
                <option>Ibagué</option>
                <option>Tolima</option>
                <option>Bogotá</option>
                <option>Medellín</option>
                <option>Otro</option>
              </select>
            </label>
            <label>
              <span>Tu nombre</span>
              <input type="text" name="name" placeholder="Ej. Camila" required />
            </label>
          </div>
          <button class="primary-button" type="submit">Continuar a WhatsApp</button>
        </form>
      </div>
    </div>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a class="brand footer-brand" href="https://tevezmarketing.digital" aria-label="Tevez Marketing logo">
            <span class="brand-mark">T</span>
            <span class="brand-text">
              <strong>Tevez</strong>
              <small>Marketing</small>
            </span>
          </a>
        </div>
        <div class="footer-links">
          <div>
            <h3>Servicios</h3>
            <a href="https://tevezmarketing.digital/estrategias-de-ventas/">Estrategias</a>
            <a href="https://tevezmarketing.digital/google-ads-ibague/">Google Ads</a>
            <a href="https://tevezmarketing.digital/publicidad-en-redes/">Redes</a>
          </div>
          <div>
            <h3>Empresa</h3>
            <a href="https://tevezmarketing.digital/quienes-somos/">Quiénes somos</a>
            <a href="https://tevezmarketing.digital/casos-de-exito/">Casos</a>
            <a href="https://tevezmarketing.digital/protocolo-360/">Protocolo</a>
          </div>
          <div>
            <h3>Cobertura</h3>
            <a href="https://tevezmarketing.digital/marketing-bogota/">Bogotá</a>
            <a href="https://tevezmarketing.digital/marketing-medellin/">Medellín</a>
            <a href="https://tevezmarketing.digital/marketing-cali/">Cali</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="container">
          <span>© 2026 Tevez Marketing</span>
          <a href="https://api.whatsapp.com/send/?phone=573170183313&text=Hola+T%C3%A9vez%2C+quiero+conocer+mis+opciones+de+marketing&type=phone_number&app_absent=0" target="_blank" rel="noreferrer noopener">Hablar por WhatsApp</a>
        </div>
      </div>
    </footer>

    <script src="/app.js" is:inline></script>
  </body>
</html>
