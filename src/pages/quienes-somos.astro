---
import GoogleTagManager from '../components/GoogleTagManager.astro';
---

<!DOCTYPE html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quiénes somos | Tevez Marketing</title>
    <meta
      name="description"
      content="Conoce a Tevez Marketing, una agencia de marketing digital con base en Ibagué que ayuda a negocios a crecer con estrategia, tecnología y resultados medibles."
    />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href="https://tevezmarketing.digital/quienes-somos/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body data-theme="charcoal">
    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand" href="https://tevezmarketing.digital" aria-label="Tevez Marketing inicio">
          <span class="brand-mark">T</span>
          <span class="brand-text">
            <strong>Tevez</strong>
            <small>Marketing</small>
          </span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menú">
          <span></span><span></span><span></span>
        </button>

        <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
          <a href="https://tevezmarketing.digital">Inicio</a>

          <div class="nav-item nav-item--submenu">
            <button class="nav-drop-toggle" type="button" aria-expanded="false" aria-controls="services-menu">
              Nuestros servicios
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3.5 6l4.5 4.5L12.5 6" />
              </svg>
            </button>
            <div class="nav-submenu" id="services-menu">
              <a href="https://tevezmarketing.digital/estrategias-de-ventas/">Estrategias de ventas</a>
              <a href="https://tevezmarketing.digital/optimizacion-de-campanas/">Optimización de campañas</a>
              <a href="https://tevezmarketing.digital/anuncios-sectores-regulados/">Anuncios sectores regulados</a>
              <a href="https://tevezmarketing.digital/sitios-web-ibague/">Sitios web Ibagué</a>
              <a href="https://tevezmarketing.digital/google-ads-ibague/">Google Ads Ibagué</a>
              <a href="https://tevezmarketing.digital/publicidad-en-redes/">Publicidad en redes</a>
            </div>
          </div>

          <a href="https://tevezmarketing.digital/quienes-somos/">Quiénes somos</a>
          <a href="https://tevezmarketing.digital/casos-de-exito/">Casos de éxito</a>
          <a href="https://tevezmarketing.digital/protocolo-360/">Protocolo 360</a>

          <div class="nav-item nav-item--submenu">
            <button class="nav-drop-toggle" type="button" aria-expanded="false" aria-controls="coverage-menu">
              Cobertura
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3.5 6l4.5 4.5L12.5 6" />
              </svg>
            </button>
            <div class="nav-submenu" id="coverage-menu">
              <a href="https://tevezmarketing.digital/marketing-bogota/">Marketing Bogotá</a>
              <a href="https://tevezmarketing.digital/marketing-medellin/">Marketing Medellín</a>
              <a href="https://tevezmarketing.digital/marketing-cali/">Marketing Cali</a>
              <a href="https://tevezmarketing.digital/marketing-usa/">Marketing USA</a>
            </div>
          </div>

          <a href="https://tevezmarketing.digital/noticias/">Noticias</a>
          <button class="nav-cta lead-trigger" type="button">Consulta gratis</button>
        </nav>
      </div>
    </header>

    <main class="landing-page">
      <section class="landing-hero theme-charcoal" data-theme="charcoal">
        <div class="container hero-grid">
          <div class="hero-copy reveal">
            <p class="eyebrow">Quiénes somos</p>
            <h1>Confiar tu negocio a una agencia es una decisión seria. Así la tratamos.</h1>
            <p class="lead">
              Somos una agencia Martech para quienes solo quieren una cosa: vender más. Web con SEO y GEO, anuncios en Google y redes, e IA aplicada a tus ventas, con resultados medibles cada mes.
            </p>
            <div class="cta-row">
              <button class="primary-button lead-trigger" type="button">Agendar consultoría gratuita</button>
              <a class="secondary-button" href="#servicios">Ver servicios</a>
            </div>
            <ul class="hero-trust">
              <li><strong>+6 años</strong><span>en marketing digital</span></li>
              <li><strong>SEO + GEO</strong><span>y estrategia comercial</span></li>
              <li><strong>Hipótesis con datos</strong><span>sin promesas vacías</span></li>
            </ul>
          </div>

          <div class="hero-visual reveal" aria-label="Retrato de Tevez Marketing">
            <div class="dashboard-window">
              <div class="window-topbar">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>

              <div class="dashboard-body">
                <div class="panel-head">
                  <div>
                    <small>Tevez</small>
                    <h2>Marketing</h2>
                  </div>
                  <span class="chip chip-accent">MARTECH</span>
                </div>

                <div class="chart-grid">
                  <article class="mini-stat">
                    <span>Marca</span>
                    <strong>+6</strong>
                    <em>años</em>
                  </article>
                  <article class="mini-stat">
                    <span>SEO</span>
                    <strong>GEO</strong>
                    <em>y IA</em>
                  </article>
                  <article class="mini-stat">
                    <span>Retorno</span>
                    <strong>Medible</strong>
                    <em>cada mes</em>
                  </article>
                </div>

                <div class="flow-panel" aria-label="Proceso de estrategia de la agencia">
                  <div class="flow-item">
                    <span class="flow-index">01</span>
                    <div>
                      <h3>Diagnóstico</h3>
                      <p>Entendemos negocio, mercado y competencia.</p>
                    </div>
                  </div>
                  <div class="flow-item">
                    <span class="flow-index">02</span>
                    <div>
                      <h3>Estrategia</h3>
                      <p>Decidimos dónde invertir y cómo medir.</p>
                    </div>
                  </div>
                  <div class="flow-item">
                    <span class="flow-index">03</span>
                    <div>
                      <h3>Optimización</h3>
                      <p>Seguimos con datos y ajuste real.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="market-strip reveal theme-marfil" aria-label="Valores" data-theme="marfil">
        <div class="container strip-inner">
          <span class="strip-label">Principios</span>
          <div class="strip-list">
            <span>Estrategia</span>
            <span>Datos</span>
            <span>Transparencia</span>
            <span>Medición</span>
            <span>Compromiso</span>
            <span>Mercado real</span>
          </div>
        </div>
      </section>

      <section class="section theme-marfil" data-theme="marfil">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Cómo trabajamos</p>
            <h2>Sabemos que detrás de cada presupuesto hay esfuerzo y una empresa que sostener.</h2>
          </div>

          <div class="landing-grid">
            <article class="reveal">
              <h3>Estrategia antes que pauta</h3>
              <p>Primero entendemos tu negocio, tu mercado y tu competencia. Después decidimos dónde y cuánto invertir.</p>
            </article>
            <article class="reveal">
              <h3>Sin promesas imposibles</h3>
              <p>No garantizamos posiciones ni resultados. Trabajamos con análisis, pruebas y medición, y te explicamos cada decisión.</p>
            </article>
            <article class="reveal">
              <h3>Decisiones con datos</h3>
              <p>Medimos contactos y ventas, no métricas de vanidad, para que sepas qué le aporta cada peso a tu negocio.</p>
            </article>
            <article class="reveal">
              <h3>Conocemos el mercado</h3>
              <p>Entendemos cómo buscan, comparan y compran las personas en tu mercado y quién compite contigo.</p>
            </article>
            <article class="reveal">
              <h3>Tecnología y SEO técnico</h3>
              <p>Sitios rápidos y bien estructurados, listos para que Google y los asistentes de IA entiendan y recomienden tu negocio.</p>
            </article>
            <article class="reveal">
              <h3>Compromiso con tigo</h3>
              <p>Acompañamiento técnico sin costo a organizaciones sin ánimo de lucro, emisoras de radio y entidades gubernamentales.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section theme-white" id="servicios" data-theme="white">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Servicios</p>
            <h2>Servicios de marketing digital para conseguir clientes.</h2>
          </div>

          <div class="landing-grid">
            <article class="reveal">
              <h3>Páginas web con SEO y GEO</h3>
              <p>Sitios rápidos y estructurados para que Google y la IA te recomienden.</p>
              <a href="https://tevezmarketing.digital/sitios-web-ibague/">Ver páginas web</a>
            </article>
            <article class="reveal">
              <h3>Google Ads</h3>
              <p>Anuncios que ponen tu negocio frente a quien ya está buscando comprar.</p>
              <a href="https://tevezmarketing.digital/google-ads-ibague/">Ver Google Ads</a>
            </article>
            <article class="reveal">
              <h3>Publicidad en redes sociales</h3>
              <p>Facebook, Instagram, TikTok, YouTube y LinkedIn para atraer clientes nuevos.</p>
              <a href="https://tevezmarketing.digital/publicidad-en-redes/">Ver redes</a>
            </article>
            <article class="reveal">
              <h3>Estrategias de ventas</h3>
              <p>Cómo atraer clientes nuevos y lograr que los actuales vuelvan a comprarte.</p>
              <a href="https://tevezmarketing.digital/estrategias-de-ventas/">Ver estrategias</a>
            </article>
            <article class="reveal">
              <h3>Optimización de campañas</h3>
              <p>Revisamos tus campañas en cada plataforma para que cada peso que inviertes rinda más.</p>
              <a href="https://tevezmarketing.digital/optimizacion-de-campanas/">Ver optimización</a>
            </article>
            <article class="reveal">
              <h3>Publicidad en sectores regulados</h3>
              <p>Anuncios para abogados, política, finanzas y otros sectores delicados, cumpliendo las reglas.</p>
              <a href="https://tevezmarketing.digital/anuncios-sectores-regulados/">Ver sectores regulados</a>
            </article>
          </div>
        </div>
      </section>

      <section class="section theme-gold" data-theme="gold">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Protocolo 360</p>
            <h2>Del diagnóstico al crecimiento medible.</h2>
          </div>

          <div class="landing-steps">
            <article class="reveal">
              <span>01</span>
              <h3>Análisis</h3>
              <p>Auditamos tu negocio, tu mercado y tu competencia para definir una estrategia clara.</p>
            </article>
            <article class="reveal">
              <span>02</span>
              <h3>Desarrollo</h3>
              <p>Construimos y mejoramos tu presencia digital: sitio web, SEO y tecnología.</p>
            </article>
            <article class="reveal">
              <span>03</span>
              <h3>Activación</h3>
              <p>Lanzamos campañas y embudos de ventas listos para generar oportunidades reales.</p>
            </article>
            <article class="reveal">
              <span>04</span>
              <h3>Optimización</h3>
              <p>Medimos, ejecutamos y escalamos con datos para mejorar resultados cada mes.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section theme-charcoal" data-theme="charcoal">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow" style="background: var(--white);">Lo que sí y no</p>
            <h2>Lo que no verás con nosotros y lo que sí.</h2>
          </div>

          <div class="landing-grid">
            <article class="reveal">
              <h3>Lo que evitamos</h3>
              <ul>
                <li>Promesas de resultados garantizados</li>
                <li>Informes llenos de métricas sin traducción a ventas</li>
                <li>Estrategias genéricas y plantillas</li>
                <li>Falta de comunicación y seguimiento</li>
                <li>Desconocimiento del mercado local</li>
              </ul>
            </article>
            <article class="reveal">
              <h3>Lo que sí encontrarás</h3>
              <ul>
                <li>Estrategias personalizadas para tu negocio</li>
                <li>Enfoque en retorno de inversión y conversión</li>
                <li>Campañas creativas y bien segmentadas</li>
                <li>Acompañamiento constante y atención directa</li>
                <li>Conocimiento del mercado de Ibagué y el Tolima</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section theme-marfil" data-theme="marfil">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Conoce a TevezMarketing</p>
            <h2>¿Quién es TevezMarketing?</h2>
          </div>

          <div class="faq-list reveal">
            <div class="faq-item"><strong>¿Quién es TevezMarketing?</strong><p>Una agencia de marketing digital con base en Ibagué ayudando a negocios a mejorar su visibilidad, captación y ventas.</p></div>
            <div class="faq-item"><strong>¿Qué servicios de marketing digital ofrecen en Ibagué y el Tolima?</strong><p>SEO, GEO, Google Ads, redes sociales, páginas web, optimización de campañas y publicidad en sectores regulados.</p></div>
            <div class="faq-item"><strong>¿Cómo empiezo a trabajar con TevezMarketing?</strong><p>Con un diagnóstico inicial por WhatsApp o videollamada para revisar tu negocio y definir el siguiente paso.</p></div>
          </div>
        </div>
      </section>

      <section class="section theme-charcoal" data-theme="charcoal">
        <div class="container landing-cta-box reveal">
          <h2>¿Hablamos de tu negocio?</h2>
          <button class="primary-button lead-trigger" type="button">Agendar consultoría gratuita</button>
        </div>
      </section>
    </main>

    <div class="lead-modal" id="lead-qualifier" aria-hidden="true">
      <div class="lead-modal-backdrop" data-close-modal="true"></div>
      <div class="lead-modal-panel" role="dialog" aria-modal="true" aria-labelledby="leadModalTitle">
        <button class="lead-close" type="button" aria-label="Cerrar formulario">×</button>
        <div class="lead-qualifier-copy lead-modal-copy">
          <p class="eyebrow">Consultoría</p>
          <h2 id="leadModalTitle">Hablemos de tu negocio y veamos por dónde empezar.</h2>
          <p class="lead-note">Un diagnóstico rápido para entender tu negocio, mercado y oportunidades reales de crecimiento.</p>
        </div>
        <form class="lead-form" id="leadForm">
          <div class="lead-options" role="radiogroup" aria-label="Qué necesita">
            <label class="option-chip"><input type="radio" name="intent" value="asesoria" checked /><span>Asesoría</span></label>
            <label class="option-chip"><input type="radio" name="intent" value="servicio" /><span>Compra de servicio</span></label>
          </div>
          <div class="lead-grid">
            <label><span>¿De dónde eres?</span><select name="city" required><option value="">Selecciona tu ciudad</option><option>Ibagué</option><option>Tolima</option><option>Bogotá</option><option>Medellín</option><option>Otro</option></select></label>
            <label><span>Tu nombre</span><input type="text" name="name" placeholder="Ej. Sebastián" required /></label>
          </div>
          <button class="primary-button" type="submit">Continuar a WhatsApp</button>
        </form>
      </div>
    </div>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a class="brand footer-brand" href="https://tevezmarketing.digital" aria-label="Tevez Marketing logo">
            <span class="brand-mark">T</span>
            <span class="brand-text"><strong>Tevez</strong><small>Marketing</small></span>
          </a>
        </div>

        <div class="footer-links">
          <div>
            <h3>Servicios</h3>
            <a href="https://tevezmarketing.digital/estrategias-de-ventas/">Estrategias</a>
            <a href="https://tevezmarketing.digital/google-ads-ibague/">Google Ads</a>
            <a href="https://tevezmarketing.digital/publicidad-en-redes/">Redes</a>
          </div>
          <div>
            <h3>Empresa</h3>
            <a href="https://tevezmarketing.digital/quienes-somos/">Quiénes somos</a>
            <a href="https://tevezmarketing.digital/casos-de-exito/">Casos</a>
            <a href="https://tevezmarketing.digital/protocolo-360/">Protocolo</a>
          </div>
          <div>
            <h3>Cobertura</h3>
            <a href="https://tevezmarketing.digital/marketing-bogota/">Bogotá</a>
            <a href="https://tevezmarketing.digital/marketing-medellin/">Medellín</a>
            <a href="https://tevezmarketing.digital/marketing-cali/">Cali</a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="container">
          <span>© 2026 Tevez Marketing</span>
          <a href="https://api.whatsapp.com/send/?phone=573170183313&text=Hola+T%C3%A9vez%2C+quiero+conocer+mis+opciones+de+marketing&type=phone_number&app_absent=0" target="_blank" rel="noreferrer noopener">Hablar por WhatsApp</a>
        </div>
      </div>
    </footer>

    <script src="/app.js" is:inline></script>
  </body>
</html>
